# ==============================================================================
# Orbit / Meow Bot — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to your production deployment environment (e.g. Vercel Project Settings > Environment Variables).
# Never commit real API keys or secrets to public version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# The fully-qualified production public domain (no trailing slash)
# Example: https://meow-bot.vercel.app
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# NextAuth Canonical URL — must match the production deployment domain
NEXTAUTH_URL="https://your-domain.vercel.app"

# NextAuth 256-bit encryption secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_here"

# ------------------------------------------------------------------------------
# 2. OAUTH IDENTITY PROVIDERS (NextAuth.js)
# ------------------------------------------------------------------------------
# GitHub OAuth App: https://github.com/settings/developers
# Production Authorization Callback URL: https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Production Authorized Redirect URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------------------------------------------
# 3. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Direct connection for migrations/schema pushes
DATABASE_URL="postgresql://user:password@ep-cool-sample.region.neon.tech/neondb?sslmode=require"

# Neon Pooled connection (PgBouncer port 6543) for serverless edge / lambda concurrency
DATABASE_URL_POOLED="postgresql://user:password@ep-cool-sample-pooler.region.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Google Gemini)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (Gemini 2.5 Flash / Flash Lite): https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 5. TOOL INTEGRATION HUB (Composio)
# ------------------------------------------------------------------------------
# Composio API Key: https://app.composio.dev/settings
# White-label redirect URI: https://your-domain.vercel.app/api/tools
COMPOSIO_API_KEY="your_composio_api_key_here"

# ------------------------------------------------------------------------------
# 6. CLOUD BROWSER AUTOMATION (Browserbase CDP)
# ------------------------------------------------------------------------------
# Browserbase API Key & Project ID: https://www.browserbase.com/
# Required for 24/7 background scheduled routine executions and cloud browser sandboxes
BROWSERBASE_API_KEY="your_browserbase_api_key_here"
BROWSERBASE_PROJECT_ID="your_browserbase_project_id_here"
WEB_AUTOMATION_HEADLESS="false"
WEB_AUTOMATION_TIMEOUT_MS="45000"

# ------------------------------------------------------------------------------
# 7. DURABLE BACKGROUND SCHEDULING (Inngest Serverless)
# ------------------------------------------------------------------------------
# Inngest Cloud Dashboard: https://app.inngest.com/
# Sync URL: https://your-domain.vercel.app/api/inngest
INNGEST_EVENT_KEY="your_inngest_event_key_here"
INNGEST_SIGNING_KEY="signkey-prod-your_signing_key_here"
